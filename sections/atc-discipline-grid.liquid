<section class="atc-disciplines">
  {% if section.blocks.size > 0 %}
    <div class="atc-disciplines__grid">
      {% for block in section.blocks %}
        {% if block.type == 'discipline' %}
          {% liquid
            assign tile_collection = block.settings.collection
            assign tile_title = block.settings.title
            if tile_title == blank
              if tile_collection != blank
                assign tile_title = tile_collection.title
              endif
            endif

            assign tile_url = block.settings.link
            if tile_url == blank
              if tile_collection != blank
                assign tile_url = tile_collection.url
              endif
            endif

            assign tile_image = block.settings.image
            if tile_image == blank
              if tile_collection.image != blank
                assign tile_image = tile_collection.image
              endif
            endif
            if tile_image == blank
              if tile_collection.products.first.featured_image != blank
                assign tile_image = tile_collection.products.first.featured_image
              endif
            endif

            assign tile_alt = ''
            if tile_image.alt != blank
              if tile_image.alt != tile_title
                assign tile_alt = tile_image.alt
              endif
            endif

            assign width_class = 'atc-disciplines__tile--narrow'
            if block.settings.width == 'wide'
              assign width_class = 'atc-disciplines__tile--wide'
            endif
          %}

          {% if tile_url != blank %}
            <a
              class="atc-disciplines__tile {{ width_class }}"
              href="{{ tile_url }}"
              {{ block.shopify_attributes }}
            >
          {% else %}
            <div
              class="atc-disciplines__tile {{ width_class }}"
              {{ block.shopify_attributes }}
            >
          {% endif %}
            {% if tile_image != blank %}
              {{
                tile_image
                | image_url: width: 1600
                | image_tag:
                  class: 'atc-disciplines__image',
                  widths: '400, 700, 1000, 1400, 1600',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  alt: tile_alt,
                  loading: 'lazy'
              }}
            {% endif %}
            {% if tile_title != blank %}
              <span class="atc-disciplines__title">{{ tile_title | escape }}</span>
            {% endif %}
          {% if tile_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="atc-disciplines__empty">{{ 'atc.home.empty_disciplines' | t }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .atc-disciplines {
    padding: 4rem clamp(1.25rem, 4vw, 3rem) 2rem;
    background: var(--atc-bg);
  }

  .atc-disciplines__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .atc-disciplines__tile {
    position: relative;
    display: block;
    min-height: 16rem;
    overflow: hidden;
    background: var(--atc-panel);
    color: var(--atc-white);
    text-decoration: none;
  }

  .atc-disciplines__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transform: scale(1.01);
  }

  .atc-disciplines__tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 55%), rgb(0 0 0 / 8%) 55%);
  }

  .atc-disciplines__title {
    position: absolute;
    z-index: 1;
    left: 1.5rem;
    bottom: 1.5rem;
    font-family: var(--atc-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .atc-disciplines__title::after {
    content: "";
    display: block;
    width: 0;
    height: 2px;
    margin-top: 0.6rem;
    background: var(--atc-white);
  }

  .atc-disciplines__tile:hover .atc-disciplines__image,
  .atc-disciplines__tile:focus-visible .atc-disciplines__image {
    transform: scale(1.04);
  }

  .atc-disciplines__tile:hover .atc-disciplines__title::after,
  .atc-disciplines__tile:focus-visible .atc-disciplines__title::after {
    width: 100%;
  }

  .atc-disciplines__tile:focus-visible {
    outline: 2px solid var(--atc-white);
    outline-offset: -4px;
  }

  .atc-disciplines__empty {
    margin: 0;
    font-family: var(--atc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--atc-muted);
  }

  @media (min-width: 990px) {
    .atc-disciplines {
      padding-block: 5rem 3rem;
    }

    .atc-disciplines__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .atc-disciplines__tile {
      min-height: 22rem;
    }

    .atc-disciplines__tile--wide {
      grid-column: span 8;
    }

    .atc-disciplines__tile--narrow {
      grid-column: span 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:atc.home.disciplines",
  "tag": "div",
  "class": "atc-disciplines-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "discipline",
      "name": "t:atc.home.discipline",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:atc.home.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:atc.home.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:atc.home.title",
          "info": "t:atc.home.title_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:atc.home.button_link",
          "info": "t:atc.home.link_info"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:atc.home.width",
          "default": "wide",
          "options": [
            { "value": "wide", "label": "t:atc.home.width_wide" },
            { "value": "narrow", "label": "t:atc.home.width_narrow" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:atc.home.disciplines",
      "blocks": [
        { "type": "discipline", "settings": { "title": "Moto racing", "width": "wide" } },
        { "type": "discipline", "settings": { "title": "Boxing", "width": "narrow" } },
        { "type": "discipline", "settings": { "title": "Tactical", "width": "narrow" } },
        { "type": "discipline", "settings": { "title": "Athletic", "width": "wide" } }
      ]
    }
  ]
}
{% endschema %}
