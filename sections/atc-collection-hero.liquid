<section class="atc-collection-hero">
  <div class="atc-collection-hero__media" aria-hidden="true">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'atc-collection-hero__video'
      }}
    {% elsif section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'atc-collection-hero__image',
          widths: '800, 1200, 1600, 2400',
          sizes: '100vw',
          alt: '',
          loading: 'eager'
      }}
    {% elsif collection.image != blank %}
      {{
        collection.image
        | image_url: width: 2400
        | image_tag:
          class: 'atc-collection-hero__image',
          widths: '800, 1200, 1600, 2400',
          sizes: '100vw',
          alt: '',
          loading: 'eager'
      }}
    {% endif %}
  </div>

  <div class="atc-collection-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="atc-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 class="atc-collection-hero__heading">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape | newline_to_br }}
      {% else %}
        {{ collection.title | escape }}
      {% endif %}
    </h1>
    {% if section.settings.text != blank %}
      <p class="atc-collection-hero__text">{{ section.settings.text | escape }}</p>
    {% elsif collection.description != blank %}
      <div class="atc-collection-hero__text">{{ collection.description }}</div>
    {% endif %}
    <p class="atc-collection-hero__count">
      {{ 'atc.commerce.specimen_count' | t: count: collection.products_count }}
    </p>
  </div>
</section>

{% stylesheet %}
  .atc-collection-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 46rem);
    background: var(--atc-bg-dark);
    color: var(--atc-white);
    overflow: hidden;
  }

  .atc-collection-hero__media,
  .atc-collection-hero__image,
  .atc-collection-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .atc-collection-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(12 12 14 / 20%) 0%, rgb(12 12 14 / 82%) 100%);
  }

  .atc-collection-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: min(100%, 72rem);
    padding: clamp(4rem, 10vw, 7rem) clamp(1.25rem, 4vw, 3rem);
  }

  .atc-collection-hero__eyebrow,
  .atc-collection-hero__count {
    margin: 0;
    font-family: var(--atc-font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atc-collection-hero__heading {
    margin: 0;
    max-width: 12em;
    font-family: var(--atc-font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 0.9;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .atc-collection-hero__text {
    max-width: 36rem;
    margin: 0;
    color: #d4d4d4;
    font-family: var(--atc-font-body);
    font-size: 1rem;
    line-height: 1.6;
  }

  .atc-collection-hero__text > * {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:atc.commerce.collection_hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:atc.home.eyebrow",
      "default": "Collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:atc.home.heading",
      "info": "t:atc.home.title_info"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:atc.home.text",
      "info": "t:atc.commerce.description_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:atc.home.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:atc.home.video"
    }
  ],
  "presets": [
    {
      "name": "t:atc.commerce.collection_hero"
    }
  ]
}
{% endschema %}
