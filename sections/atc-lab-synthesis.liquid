<section class="atc-lab-synthesis">
  <div class="atc-lab-synthesis__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="atc-lab-synthesis__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="atc-lab-synthesis__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="atc-lab-synthesis__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="atc-lab-synthesis__grid">
      {% for block in section.blocks %}
        <article class="atc-lab-synthesis__stat" {{ block.shopify_attributes }}>
          {% if block.settings.value != blank %}
            <p class="atc-lab-synthesis__value">{{ block.settings.value | escape }}</p>
          {% endif %}
          {% if block.settings.label != blank %}
            <h3 class="atc-lab-synthesis__label">{{ block.settings.label | escape }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="atc-lab-synthesis__note">{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="atc-lab-synthesis__note">{{ 'atc.commerce.add_stats' | t }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .atc-lab-synthesis {
    display: grid;
    gap: 2.5rem;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem);
    background: var(--atc-bg-dark);
    color: var(--atc-white);
  }

  .atc-lab-synthesis__eyebrow,
  .atc-lab-synthesis__label {
    margin: 0;
    font-family: var(--atc-font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a3a3a3;
  }

  .atc-lab-synthesis__heading {
    margin: 0.75rem 0 0;
    max-width: 14em;
    font-family: var(--atc-font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .atc-lab-synthesis__text,
  .atc-lab-synthesis__note {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: #d4d4d4;
    font-family: var(--atc-font-body);
    line-height: 1.6;
  }

  .atc-lab-synthesis__grid {
    display: grid;
    gap: 1px;
    background: var(--atc-line-dark);
    border: 1px solid var(--atc-line-dark);
  }

  .atc-lab-synthesis__stat {
    padding: 1.5rem;
    background: var(--atc-panel);
  }

  .atc-lab-synthesis__value {
    margin: 0 0 0.75rem;
    font-family: var(--atc-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  @media (min-width: 750px) {
    .atc-lab-synthesis__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:atc.commerce.lab_synthesis",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:atc.home.eyebrow",
      "default": "Laboratory"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:atc.home.heading",
      "default": "Lab synthesis"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:atc.home.text"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:atc.commerce.stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:atc.commerce.value",
          "default": "0.01%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:atc.commerce.label",
          "default": "Field threshold"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:atc.home.text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:atc.commerce.lab_synthesis",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "0.01%",
            "label": "Field threshold",
            "text": "Specimens are cut and tested against the laboratory performance line."
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "04",
            "label": "Collection index",
            "text": "Replace these figures with the notes for this collection."
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Lab",
            "label": "Origin",
            "text": "Editorial measurements stay in the theme editor. Product data stays in Shopify."
          }
        }
      ]
    }
  ]
}
{% endschema %}
