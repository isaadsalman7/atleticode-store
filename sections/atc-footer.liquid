{% liquid
  assign year = 'now' | date: '%Y'
  assign brand = section.settings.brand
  if brand == blank
    assign brand = shop.name
  endif
%}

<div class="atc-footer">
  <div class="atc-footer__grid">
    <div class="atc-footer__identity">
      <p class="atc-footer__brand">{{ brand | escape }}</p>
      <p class="atc-footer__copyright">
        {{ 'atc.footer.copyright' | t: year: year, shop_name: shop.name }}
      </p>
    </div>

    <div class="atc-footer__columns">
      {% for column in (1..3) %}
        {% liquid
          assign heading = blank
          assign column_key = column | append: ''
          if column == 1
            assign heading = section.settings.heading_1
          endif
          if column == 2
            assign heading = section.settings.heading_2
          endif
          if column == 3
            assign heading = section.settings.heading_3
          endif
        %}
        <div class="atc-footer__column">
          {% if heading != blank %}
            <p class="atc-footer__heading">{{ heading | escape }}</p>
          {% endif %}
          {% for block in section.blocks %}
            {% if block.type == 'link' %}
              {% assign block_column = block.settings.column | append: '' %}
              {% if block_column == column_key %}
                {% if block.settings.label != blank %}
                  <a
                    class="atc-footer__link"
                    href="{{ block.settings.url | default: '#' }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label | escape }}
                  </a>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:atc.footer.name",
  "tag": "div",
  "class": "atc-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "t:atc.footer.brand",
      "default": "ATLETICODE"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "t:atc.footer.heading_1"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "t:atc.footer.heading_2"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "t:atc.footer.heading_3",
      "default": "Social"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:atc.footer.link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:atc.footer.label",
          "default": "Privacy"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:atc.footer.url"
        },
        {
          "type": "select",
          "id": "column",
          "label": "t:atc.footer.column",
          "default": "1",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:atc.footer.name",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
