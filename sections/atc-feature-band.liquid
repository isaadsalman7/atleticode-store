<section class="atc-features">
  <div class="atc-features__grid">
    {% for block in section.blocks %}
      {% if block.type == 'feature' %}
        <article class="atc-features__item" {{ block.shopify_attributes }}>
          <span class="atc-features__icon">
            {% render 'atc-icon', icon: block.settings.icon %}
          </span>
          {% if block.settings.heading != blank %}
            <h2 class="atc-features__heading">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="atc-features__text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .atc-features {
    background: var(--atc-ink);
    color: var(--atc-white);
    padding: 4.5rem clamp(1.25rem, 4vw, 3rem);
  }

  .atc-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .atc-features__item {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 22rem;
  }

  .atc-features__icon {
    color: #a3a3a3;
  }

  .atc-features__heading {
    margin: 0;
    font-family: var(--atc-font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .atc-features__text {
    margin: 0;
    font-family: var(--atc-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #c8c8c8;
  }

  @media (min-width: 750px) {
    .atc-features__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem 2rem;
    }
  }

  @media (min-width: 990px) {
    .atc-features {
      padding-block: 7rem;
    }

    .atc-features__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:atc.home.feature_band",
  "tag": "div",
  "class": "atc-features-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "t:atc.home.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:atc.home.icon",
          "default": "chart",
          "options": [
            { "value": "chart", "label": "t:atc.home.icon_chart" },
            { "value": "layers", "label": "t:atc.home.icon_layers" },
            { "value": "athlete", "label": "t:atc.home.icon_athlete" },
            { "value": "globe", "label": "t:atc.home.icon_globe" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:atc.home.heading",
          "default": "Performance coded"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:atc.home.text",
          "default": "Every fiber is analyzed for kinetic efficiency and moisture displacement."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:atc.home.feature_band",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "chart",
            "heading": "Performance coded",
            "text": "Every fiber is analyzed for kinetic efficiency and moisture displacement at molecular scales."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "layers",
            "heading": "Engineered materials",
            "text": "Proprietary synthetic blends that provide 3x the tensile strength of traditional textiles."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "athlete",
            "heading": "Built for athletes",
            "text": "Tested in high-gravity environments to ensure integrity under extreme physical stress."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "globe",
            "heading": "Global logistics",
            "text": "Proprietary delivery network ensuring your performance tools arrive anywhere in under 48 hours."
          }
        }
      ]
    }
  ]
}
{% endschema %}
