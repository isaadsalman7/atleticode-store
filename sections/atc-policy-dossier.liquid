<section class="atc-dossier">
  <header class="atc-dossier__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="atc-dossier__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 class="atc-dossier__heading">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape | newline_to_br }}
      {% elsif page.title != blank %}
        {{ page.title | escape }}
      {% endif %}
    </h1>
    {% if section.settings.text != blank %}
      <p class="atc-dossier__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="atc-dossier__list">
      {% for block in section.blocks %}
        <article class="atc-dossier__protocol" {{ block.shopify_attributes }}>
          <div class="atc-dossier__copy">
            {% if block.settings.number != blank %}
              <p class="atc-dossier__number">{{ block.settings.number | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endif %}
            {% if block.settings.link_label != blank %}
              {% if block.settings.link != blank %}
                <a class="atc-button" href="{{ block.settings.link }}">
                  {{ block.settings.link_label | escape }}
                </a>
              {% endif %}
            {% endif %}
          </div>
          <div class="atc-dossier__specs">
            {% render 'atc-spec', label: block.settings.spec_label_1, value: block.settings.spec_value_1 %}
            {% render 'atc-spec', label: block.settings.spec_label_2, value: block.settings.spec_value_2 %}
            {% render 'atc-spec', label: block.settings.spec_label_3, value: block.settings.spec_value_3 %}
            {% render 'atc-spec', label: block.settings.spec_label_4, value: block.settings.spec_value_4 %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="atc-dossier__empty">{{ 'atc.policies.add_protocol' | t }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .atc-dossier {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 3rem);
    background: var(--atc-bg);
    color: var(--atc-ink);
  }

  .atc-dossier__eyebrow,
  .atc-dossier__number,
  .atc-spec__label {
    margin: 0;
    font-family: var(--atc-font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--atc-muted);
  }

  .atc-dossier__heading,
  .atc-dossier__protocol h2 {
    margin: 0.75rem 0 0;
    font-family: var(--atc-font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .atc-dossier__heading {
    max-width: 12em;
    font-size: clamp(2.4rem, 7vw, 5.5rem);
  }

  .atc-dossier__text,
  .atc-dossier__protocol p {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-family: var(--atc-font-body);
    font-size: 1rem;
    line-height: 1.65;
  }

  .atc-dossier__list {
    display: flex;
    flex-direction: column;
  }

  .atc-dossier__protocol {
    display: grid;
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--atc-line);
  }

  .atc-dossier__protocol h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .atc-dossier__copy .atc-button {
    margin-top: 1.5rem;
  }

  .atc-dossier__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--atc-line);
    border: 1px solid var(--atc-line);
  }

  .atc-spec {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 5.5rem;
    padding: 1rem;
    background: var(--atc-bg);
  }

  .atc-spec__value {
    margin: 0;
    font-family: var(--atc-font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .atc-dossier__empty {
    margin: 0;
    color: var(--atc-muted);
  }

  @media (min-width: 990px) {
    .atc-dossier__protocol {
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
      gap: 3rem;
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
