{% doc %}
  Renders made-to-order, shipping-policy, series, and artwork-upload UI for a product.

  Shipping and series names come from the catalog snippets.
  Artwork upload follows `custom.custom_upload` = Yes, and otherwise Motorsport and Custom Teamwear.

  @param {product} product - Product to describe
  @param {string} part - Fragment to render: card-badge, lead, shipping, artwork, subline, or policy-key

  @example
  {% render 'atc-fulfillment', product: product, part: 'lead' %}
{% enddoc %}

{% liquid
  assign catalog_key = product.type | downcase
  assign catalog_tags = product.tags | join: ',' | downcase
assign made_to_order = true
  if product.metafields.custom.made_to_order.value == false
    assign made_to_order = false
  endif
  if product.tags contains 'ready-to-ship'
    assign made_to_order = false
  endif

  assign upload_raw = product.metafields.custom.custom_upload.value
  assign upload_text = upload_raw | downcase
  assign artwork = false
  assign upload_known = false
  if upload_raw == true
    assign artwork = true
    assign upload_known = true
  endif
  if upload_text == 'yes'
    assign artwork = true
    assign upload_known = true
  endif
  if upload_raw == false
    assign artwork = false
    assign upload_known = true
  endif
  if upload_text == 'no'
    assign artwork = false
    assign upload_known = true
  endif
  if upload_known == false
    if product.metafields.custom.artwork_upload.value
      assign artwork = true
      assign upload_known = true
    endif
  endif
  if upload_known == false
    if catalog_key == 'motorsport'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_key == 'custom teamwear'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'custom-upload'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'artwork-upload'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'custom-lab'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'grid'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'motorsport'
      assign artwork = true
    endif
  endif
  if upload_known == false
    if catalog_tags contains 'custom-teamwear'
      assign artwork = true
    endif
  endif
%}

{% case part %}
  {% when 'policy-key' %}
    {%- render 'atc-catalog-policy', product: product, part: 'key' -%}
  {% when 'subline' %}
    {%- render 'atc-catalog-series', product: product -%}
  {% when 'card-badge' %}
    {% if made_to_order %}
      <span class="atc-card__status atc-card__status--order">{{ 'atc.commerce.made_to_order' | t }}</span>
    {% endif %}
  {% when 'lead' %}
    {% if made_to_order %}
      <p class="atc-fulfillment__lead">{{ 'atc.commerce.made_to_order_lead' | t }}</p>
    {% endif %}
  {% when 'shipping' %}
    {% render 'atc-catalog-policy', product: product, part: 'message' %}
  {% when 'artwork' %}
    {% if artwork %}
      <label class="atc-fulfillment__artwork" for="AtcArtwork-{{ product.id }}">
        <span>{{ 'atc.commerce.artwork_label' | t }}</span>
        <input
          id="AtcArtwork-{{ product.id }}"
          type="file"
          name="properties[Custom Design]"
          accept=".png,.pdf,.ai,.psd,image/png,application/pdf"
        >
        <span class="atc-fulfillment__hint">{{ 'atc.commerce.artwork_hint' | t }}</span>
        <span class="atc-fulfillment__hint">{{ 'atc.commerce.artwork_proofing' | t }}</span>
      </label>
    {% endif %}
{% endcase %}

{% stylesheet %}
  .atc-card__status--order {
    top: auto;
    bottom: 0.75rem;
    background: var(--atc-bg-dark);
    color: var(--atc-white);
  }

  .atc-fulfillment__lead,
  .atc-fulfillment__shipping,
  .atc-fulfillment__hint {
    margin: 0;
    font-family: var(--atc-font-body);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .atc-fulfillment__lead {
    color: var(--atc-ink);
    font-family: var(--atc-font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .atc-fulfillment__shipping,
  .atc-fulfillment__hint {
    color: var(--atc-muted);
  }

  .atc-fulfillment__artwork {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: min(100%, 24rem);
    font-family: var(--atc-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .atc-fulfillment__artwork input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem;
    border: 1px solid var(--atc-ink);
    border-radius: 0;
    background: var(--atc-bg);
    color: var(--atc-ink);
    font-family: var(--atc-font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .atc-fulfillment__artwork input:focus-visible {
    outline: var(--atc-focus);
    outline-offset: 3px;
  }
{% endstylesheet %}
